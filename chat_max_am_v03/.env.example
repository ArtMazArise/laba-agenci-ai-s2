# Ustawienia niesekretne: najpierw config.json; brakujące pola z env.
# Klucze API, hasło, SESSION_SECRET i token Blob: wyłącznie env.
OPENROUTER_ENABLED=true
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
GEMINI_ENABLED=true
GOOGLE_GENERATIVE_AI_API_KEY=
GEMINI_MODEL=
CHAT_PASSWORD=
CHAT_MAX_ATTEMPTS=5
CHAT_DUEL_ROUNDS=5
# true wczytuje config/test-questions.json; false wyłącza odczyt listy.
CHAT_TEST_QUESTIONS_ENABLED=true
SESSION_SECRET=
# Lokalnie zostaw puste. Produkcja: absolutna ścieżka do trwałego
# katalogu współdzielonego przez WSZYSTKIE instancje aplikacji.
AUTH_STATE_DIR=
# W npm run dev odświeżenie resetuje próby. W produkcji tryb nauki nie działa.
AUTH_LEARNING_MODE=true
# Vercel: token prywatnego Blob Store, dodawany przez integrację Storage.
BLOB_READ_WRITE_TOKEN=

# Lista użytych narzędzi w nowych odpowiedziach i kopiach; config.json ma pierwszeństwo.
CHAT_SHOW_USED_TOOLS=true

# Model generowania obrazów (config.json ma pierwszeństwo).
OPENROUTER_IMAGE_MODEL=google/gemini-3.1-flash-image-preview
