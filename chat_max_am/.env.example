OPENROUTER_ENABLED=true
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
GEMINI_ENABLED=true
GOOGLE_GENERATIVE_AI_API_KEY=
GEMINI_MODEL=
CHAT_PASSWORD=
CHAT_MAX_ATTEMPTS=5
CHAT_DUEL_ROUNDS=5
# Edytowalne podpowiedzi wspólnej wiadomości: tablica JSON. Puste lub [] wyłącza listę.
CHAT_TEST_QUESTIONS='["Czy mogę dostać rabat na konsultację?","Co tu robisz?","Kim jesteś?","Która jest godzina?","Jaki dziś dzień?","W czym możesz mi pomóc?"]'
SESSION_SECRET=
# Lokalnie zostaw puste. Produkcja: absolutna ścieżka do trwałego
# katalogu współdzielonego przez WSZYSTKIE instancje aplikacji.
AUTH_STATE_DIR=
# W npm run dev odświeżenie resetuje próby. W produkcji tryb nauki nie działa.
AUTH_LEARNING_MODE=true
# Vercel: token prywatnego Blob Store, dodawany przez integrację Storage.
BLOB_READ_WRITE_TOKEN=
